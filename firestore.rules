rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated task subcollections per user: users/{userId}/tasks/{taskId}
    match /users/{userId}/tasks/{taskId} {
      // Authenticated user can read, create, update, and delete only their own tasks
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Top-level tasks collection (backward-compatible fallback)
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
